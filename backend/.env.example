# ============================================
# AZOLVE BACKEND - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Server ----
NODE_ENV=production
PORT=3000

# ---- MongoDB Atlas (FREE TIER) ----
# Get this from: https://cloud.mongodb.com
# Steps: Create Cluster → Connect → Connect your application → Copy string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/azolve_db?retryWrites=true&w=majority

# ---- JWT Authentication ----
# Generate a random string (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-too
JWT_REFRESH_EXPIRE=30d

# ---- Frontend URL (Your GoDaddy Domain) ----
FRONTEND_URL=https://azolve.io

# ---- Backend URL (Your Render.com URL) ----
BACKEND_URL=https://azolve-api.onrender.com

# ---- Email Configuration ----
# ================================================================
# BEST FREE OPTIONS FOR EMAIL (choose ONE):
#
# OPTION 1: Brevo (RECOMMENDED - Best Free Tier)
#    300 emails/day FREE forever, no credit card needed
#    Steps: signup at brevo.com - SMTP and API - Generate SMTP key
#    EMAIL_HOST=smtp-relay.brevo.com
#    EMAIL_PORT=587
#    EMAIL_SECURE=false
#    EMAIL_USER=your-brevo-login-email@example.com
#    EMAIL_PASS=your-brevo-smtp-key
#    EMAIL_FROM=Azolve <connect@azolve.io>
#
# OPTION 2: Gmail (Free, easy but lower deliverability)
#    Steps: Google Account - Security - App Passwords - Generate
#    EMAIL_HOST=smtp.gmail.com
#    EMAIL_PORT=587
#    EMAIL_SECURE=false
#    EMAIL_USER=yourgmail@gmail.com
#    EMAIL_PASS=xxxx-xxxx-xxxx-xxxx   (16-char App Password)
#    EMAIL_FROM=Azolve <yourgmail@gmail.com>
#
# OPTION 3: Your cPanel domain email (azolve.io)
#    Login cPanel - Email Accounts - Create connect@azolve.io
#    EMAIL_HOST=mail.azolve.io
#    EMAIL_PORT=587
#    EMAIL_SECURE=false
#    EMAIL_USER=connect@azolve.io
#    EMAIL_PASS=your-cpanel-email-password
#    EMAIL_FROM=Azolve <connect@azolve.io>
# ================================================================

# ---- Brevo HTTP API (RECOMMENDED for Render.com free tier) ----
# Render.com free tier blocks SMTP ports (25, 465, 587) since Sept 2025.
# The Brevo HTTP API uses HTTPS (port 443) which is NOT blocked.
# Setup: Brevo Dashboard → SMTP & API → API Keys → Generate new key
# Also verify your sender email in Brevo → Senders
BREVO_API_KEY=your-brevo-api-key-here

# Sender email address (must be verified in Brevo → Senders)
EMAIL_FROM_ADDRESS=connect@azolve.io
EMAIL_FROM_NAME=Azolve

# ---- SMTP Config (fallback, may NOT work on Render free tier) ----
# SMTP Login is NOT your Brevo account email
# It's the special login shown in Brevo → SMTP & API tab (format: xxxxxxxx@smtp-brevo.com)
# If BREVO_API_KEY is set, SMTP is used only as fallback if API fails
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-login@smtp-brevo.com
EMAIL_PASS=your-brevo-smtp-password
EMAIL_FROM=Azolve <connect@azolve.io>

# ---- File Upload ----
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ---- Admin Account (Created on first run) ----
ADMIN_EMAIL=admin@azolve.io
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin

# ---- AI Co-Pilot (Gemini) ----
# Powers the "Azolve AI" chat assistant — real conversational AI that can
# create invoices/quotations/leads/tasks/clients, apply leave, answer
# business questions from live data, and chat about anything else, like
# ChatGPT but wired into your own company data.
# Get a FREE key: https://ai.google.dev  -> "Get API key"
# Without this key set, the assistant still answers common questions via
# fast built-in commands, but cannot hold a conversation or take actions
# from free-form phrasing.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional — override the model (defaults to gemini-2.5-flash, free tier eligible)
GEMINI_MODEL=gemini-2.5-flash

# ---- Cashfree Payment Gateway ----
# Get from: https://merchant.cashfree.com/merchants/developer/apikeys
# Use 'sandbox' for testing, 'production' for live payments
CASHFREE_ENV=production
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID
CASHFREE_SECRET=YOUR_CASHFREE_SECRET

# ---- Canva Connect API ----
# Real Canva integration (Canva Studio in the sidebar) — lets each user
# connect their own Canva account and create/edit/export real designs.
# 1. Go to https://www.canva.com/developers -> "Create an integration"
#    (choose "Connect API" / public or private integration).
# 2. Under Scopes, enable: design:content:read, design:content:write,
#    design:meta:read, folder:read, folder:write, asset:read,
#    asset:write, profile:read
# 3. Under Authentication, add the redirect URL below EXACTLY as your
#    backend's public URL + /api/canva/oauth/callback
# 4. Copy the Client ID and Client Secret here.
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
# Must exactly match a Redirect URL configured in the Canva Developer Portal.
# Local dev example: http://localhost:3000/api/canva/oauth/callback
CANVA_REDIRECT_URI=http://localhost:3000/api/canva/oauth/callback